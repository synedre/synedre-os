# ═══ Synedre OS — strict .gitignore ═══
# Principle: we version the STRUCTURE and the foundation (README, install.sh,
# .tpl.* templates, publish-whitelist). We ignore live STATE, secrets and the
# private brain.

# ── Live state (00_ourobouros) — never committed ──
00_ourobouros/logs/
00_ourobouros/tmp/
00_ourobouros/backups/
00_ourobouros/.chaos/*
!00_ourobouros/.chaos/.gitkeep
00_ourobouros/tests/_run/
*.log

# ── Private brain (moat) — NEVER in the public repo ──
core/shyrka/brain/*
!core/shyrka/brain/.gitignore
!core/shyrka/brain/README.md

# ── Secrets & environment ──
.env
.env.*
!.env.example
*.key
*.pem
*.p12
02_atlas/secrets/

# ── Local release denylist (YOUR real tenant codenames — private) ──
# The .example template ships; the real list never does (CLAUDE.md Rule 3).
02_atlas/workers/release/sy_codename_denylist.txt

# ── Local release private config (YOUR monolith paths / schema / SQL messages) ──
# Same rule: the .example.json template ships, the real one never does.
02_atlas/workers/release/sy_private_config.json

# ── Business data (01_founder) — PII ──
01_founder/customers/**
01_founder/leads/**
!01_founder/customers/.gitkeep
!01_founder/leads/.gitkeep

# ── Build & dependencies ──
node_modules/
.nuxt/
.output/
dist/
__pycache__/
*.pyc
.pytest_cache/
coverage/
*.tgz

# ── OS / editors ──
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Local harness artifacts (generated by install.sh) ──
.claude/
.kimi-code/

# ── Local AI config (machine-local, not part of the public repo) ──
CLAUDE.md

# ── Harness session state written INTO this tree by the local hooks ──
# Session handoffs and guard marks land in synedre/state/ because the hooks
# resolve paths from the CWD, not from the monolith root. They hold internal
# context (backlog, legal posture, tenant work) and must never be published.
synedre/
