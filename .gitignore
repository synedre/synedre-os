# ═══ Synedre OS — strict .gitignore ═══
# Principle: we version the STRUCTURE and the foundation (README, install.sh,
# .tpl.* templates, publish-whitelist). We ignore live STATE, secrets and the
# private brain.

# ── Live state (00_ourobouros) — never committed ──
00_ourobouros/logs/
00_ourobouros/tmp/
00_ourobouros/backups/
00_ourobouros/.chaos/*
!00_ourobouros/.chaos/.gitkeep
00_ourobouros/tests/_run/
*.log

# ── Private brain (moat) — NEVER in the public repo ──
core/shirka/brain/*
!core/shirka/brain/.gitignore
!core/shirka/brain/README.md

# ── Secrets & environment ──
.env
.env.*
!.env.example
*.key
*.pem
*.p12
02_atlas/secrets/

# ── Business data (01_founder) — PII ──
01_founder/customers/**
01_founder/leads/**
!01_founder/customers/.gitkeep
!01_founder/leads/.gitkeep

# ── Build & dependencies ──
node_modules/
.nuxt/
.output/
dist/
__pycache__/
*.pyc
.pytest_cache/
coverage/
*.tgz

# ── OS / editors ──
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Local harness artifacts (generated by install.sh) ──
.claude/
.kimi-code/

# ── Local AI config (machine-local, not part of the public repo) ──
CLAUDE.md
